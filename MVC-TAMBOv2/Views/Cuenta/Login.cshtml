<div class="card card-tambo mx-auto mt-5" style="max-width:450px;">
    <div class="card-header">
        Iniciar Sesión
    </div>

    <div class="card-body">

        <form asp-action="Login" method="post">

            <input type="email" name="correo" class="form-control mb-3" placeholder="Correo" required />

            <input type="password" name="password" class="form-control mb-4" placeholder="Contraseña" required />

            <button class="btn btn-tambo w-100">Ingresar</button>

        </form>

    </div>
</div>
