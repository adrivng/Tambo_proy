<div class="d-flex justify-content-center mt-5">
    <div class="login-card shadow">

        <!-- LOGO TAMBO -->
        <div class="text-center mb-3">
            <img src="~/img/logotambo.png" style="height:90px; width:auto;" />
        </div>

        <h3 class="text-center fw-bold mb-4" style="color:#7A1FA2;">Bienvenido</h3>

        <form asp-action="Login" method="post">

            <input type="email"
                   name="correo"
                   class="form-control tam-input mb-3"
                   placeholder="Correo electrónico"
                   required />

            <input type="password"
                   name="password"
                   class="form-control tam-input mb-4"
                   placeholder="Contraseña"
                   required />

            <!-- BOTÓN LOGIN NEGRO -->
            <button type="submit" class="btn btn-login w-100 mb-3">
                Login
            </button>

            <!-- BOTÓN MOSTAZA VOLVER -->
            <a asp-controller="Tambo" asp-action="MenuPrincipal"
               class="btn btn-mostaza w-100">
                Volver
            </a>
            <br />
            <!-- ENLACE DE REGISTRO -->
            @* <div 
                class="text-center mt-3">
                <small>
                    ¿No tienes cuenta?
                    <a asp-controller="Cuenta"
                       asp-action="RegistroCliente"
                       style="color:#7A1FA2; font-weight:bold; text-decoration:none;">
                        Regístrate aquí
                    </a>
                </small>
            </div> *@

            <div class="text-center mt-3">
                ¿No tienes cuenta?
                <a asp-controller="Cuenta"
                   asp-action="RegistroCliente"
                   class="fw-bold"
                   style="color:#7A1FA2; text-decoration:none;">
                    Regístrate aquí
                </a>
            </div>

        </form>
    </div>
</div>

<script>
    // 👉 Antes de enviar el formulario copiamos el correo escrito
    document.querySelector("form[method='get']").onsubmit = function () {
        document.getElementById("correoOculto").value =
            document.getElementById("correoLogin").value;
    };
</script>