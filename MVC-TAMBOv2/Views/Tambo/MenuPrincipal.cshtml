@{
    ViewData["Title"] = "Menú Principal";
}


<!-- se agrego para que solo cargue en el menu principal con render section desde Loyout
	en la primera linea dentro del body -->
@section ExtraTop {
    <div class="tambo-header-ticker">
        <div class="tambo-ticker-content">
            🎉 Promociones disponibles hoy — ¡Aprovecha nuestras ofertas especiales! — Delivery Tambo 24/7 🚀
        </div>
    </div>
}

<body class="menu-fondo">       

    <div class="container mt-4">

        <!-- HEADER -->
        <header class="text-center mb-4">
            <img src="~/img/logotambo.png" alt="Logo" class="tambo-logo" />
            <h1 class="mt-2">Tambo - Pedido en Línea</h1>
        </header>

        <!-- BARRA DE NAVEGACIÓN -->
        <nav class="tambo-nav d-flex justify-content-center mb-4">
            <a href="#" class="btn nav-btn mx-2">Inicio</a>
            <a asp-controller="Home" asp-action="Productos" class="btn nav-btn-outline mx-2">Productos</a>
            <a href="#" class="btn nav-btn-outline mx-2">Promociones</a>
            <a href="#" class="btn nav-btn-outline mx-2">Mi carrito</a>
        </nav>


        <main class="row mt-4">

            <div class="col-md-3">
                <h4 class="text-white">Categorías</h4>

                <div class="categorias-box">
                    <ul class="list-group">
                        <li class="list-group-item"><a href="/Home/Productos#snacks" class="categoria-link">Snacks</a></li>
                        <li class="list-group-item"><a href="/Home/Productos#galletas" class="categoria-link">Galletas</a></li>
                        <li class="list-group-item"><a href="/Home/Productos#gaseosas" class="categoria-link">Gaseosas</a></li>
                        <li class="list-group-item"><a href="/Home/Productos#aguas" class="categoria-link">Aguas</a></li>
                        <li class="list-group-item"><a href="/Home/Productos#packs" class="categoria-link">Packs</a></li>
                        <li class="list-group-item"><a href="/Home/Productos#cerveza" class="categoria-link">Cerveza</a></li>
                        <li class="list-group-item"><a href="/Home/Productos#licores" class="categoria-link">Licores</a></li>
                        <li class="list-group-item"><a href="/Home/Productos#chocolates" class="categoria-link">Chocolates</a></li>
                    </ul>
                </div>

            </div>

            <!-- PRODUCTOS -->
            <div class="col-md-9">
                <h4>Productos disponibles</h4>
                <div class="row">

                    <div class="col-md-4 mb-3">
                        <div class="card">
                            <img src="~/img/inka.jpg" class="card-img-top" alt="Producto">
                            <div class="card-body text-center">
                                <h5 class="card-title">Gaseosa Inka Cola 500ml personal</h5>
                                <p class="card-text">S/ 3.50</p>
                                <button class="btn btn-success">Agregar</button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="card">
                            <img src="~/img/lays.jpg" class="card-img-top" alt="Producto">
                            <div class="card-body text-center">
                                <h5 class="card-title">Papas Lay's corte americano 150g</h5>
                                <p class="card-text">S/ 4.00</p>
                                <button class="btn btn-success">Agregar</button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="card">
                            <img src="~/img/choco.jpg" class="card-img-top" alt="Producto">
                            <div class="card-body text-center">
                                <h5 class="card-title">Pastillas de chocolate Fondant 150g</h5>
                                <p class="card-text">S/ 2.50</p>
                                <button class="btn btn-success">Agregar</button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="card">
                            <img src="~/img/chifles.jpg" class="card-img-top" alt="Producto">
                            <div class="card-body text-center">
                                <h5 class="card-title">Crickets bolsa Chifles salados 150g</h5>
                                <p class="card-text">S/ 7.90</p>
                                <button class="btn btn-success">Agregar</button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="card">
                            <img src="~/img/panetoncito.jpg" class="card-img-top" alt="Producto">
                            <div class="card-body text-center">
                                <h5 class="card-title">Mini Panetón Donofrio Chocotoncito 80g</h5>
                                <p class="card-text">S/ 4.40</p>
                                <button class="btn btn-success">Agregar</button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="card">
                            <img src="~/img/sanmateo.jpg" class="card-img-top" alt="Producto">
                            <div class="card-body text-center">
                                <h5 class="card-title">Agua de Manantial San Mateo 500ml</h5>
                                <p class="card-text">S/ 2.50</p>
                                <button class="btn btn-success">Agregar</button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="card">
                            <img src="~/img/field.jpg" class="card-img-top" alt="Producto">
                            <div class="card-body text-center">
                                <h5 class="card-title">Galleta Field Vainilla Sixpack 222g</h5>
                                <p class="card-text">S/ 5.50</p>
                                <button class="btn btn-success">Agregar</button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="card">
                            <img src="~/img/ritz.jpg" class="card-img-top" alt="Producto">
                            <div class="card-body text-center">
                                <h5 class="card-title">Galleta Ritz Original Sixpack 120g</h5>
                                <p class="card-text">S/ 4.80</p>
                                <button class="btn btn-success">Agregar</button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="card">
                            <img src="~/img/packcocas.jpg" class="card-img-top" alt="Producto">
                            <div class="card-body text-center">
                                <h5 class="card-title">Pack Coca Cola 3L + Inka Cola 3L</h5>
                                <p class="card-text">S/ 20</p>
                                <button class="btn btn-success">Agregar</button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="card">
                            <img src="~/img/bigcola.jpg" class="card-img-top" alt="Producto">
                            <div class="card-body text-center">
                                <h5 class="card-title">Gaseosa Big Cola 1.7L</h5>
                                <p class="card-text">S/ 4.30</p>
                                <button class="btn btn-success">Agregar</button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="card">
                            <img src="~/img/bigcola.jpg" class="card-img-top" alt="Producto">
                            <div class="card-body text-center">
                                <h5 class="card-title">Gaseosa Big Cola 1.7L</h5>
                                <p class="card-text">S/ 4.30</p>
                                <button class="btn btn-success">Agregar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>           
        </main>
</body>