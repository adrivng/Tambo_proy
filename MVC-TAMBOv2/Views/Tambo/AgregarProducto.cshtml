@model MVC_TAMBOv2.ViewModel.ProductoViewModel

@{
    ViewData["Title"] = "AgregarProducto";
}

<h2 class="text-center fw-bold mb-4" style="color:#7A1FA2;">Registrar Producto</h2>

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="card shadow card-tambo">
            <div class="card-body">

                <form asp-action="AgregarProducto">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Nombre" class="fw-bold"></label>
                        <input asp-for="Nombre" class="form-control" />
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Precio" class="fw-bold"></label>
                        <input asp-for="Precio" class="form-control" />
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="FechaExpiracion" class="fw-bold"></label>
                        <input asp-for="FechaExpiracion" class="form-control" type="date" />
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Marca" class="fw-bold"></label>
                        <input asp-for="Marca" class="form-control" />
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Categoria" class="fw-bold"></label>
                        <input asp-for="Categoria" class="form-control" />
                    </div>

                    <button type="submit" class="btn btn-tambo w-100">
                        Registrar Producto
                    </button>

                </form>

            </div>
        </div>

        <div class="text-center mt-3">
            <a asp-action="Index" class="text-decoration-none fw-bold" style="color:#7A1FA2;">← Volver</a>
        </div>

    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
