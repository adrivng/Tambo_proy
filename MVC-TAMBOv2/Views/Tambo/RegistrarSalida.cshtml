@model MVC_TAMBOv2.ViewModel.Almacen.RegistrarSalidaViewModel

<h2 class="text-center fw-bold mb-4" style="color:#7A1FA2;">Registrar Salida de Producto</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger text-center fw-bold">@TempData["Error"]</div>
}

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="card card-tambo shadow">
            <div class="card-body">

                <form asp-action="RegistrarSalida">

                    <input type="hidden" asp-for="IdProducto" />

                    <div class="mb-3">
                        <label class="fw-bold">Producto</label>
                        <input class="form-control" value="@Model.NombreProducto" disabled />
                    </div>

                    <div class="mb-3">
                        <label class="fw-bold">Cantidad a retirar</label>
                        <input asp-for="Cantidad" type="number" class="form-control" min="1" />
                    </div>

                    <div class="mb-4">
                        <label class="fw-bold">Motivo</label>
                        <input asp-for="Motivo" class="form-control" placeholder="Ejemplo: devolución, pérdida..." />
                    </div>

                    <button type="submit" class="btn btn-tambo w-100">
                        Registrar Salida
                    </button>

                    <div class="text-center mt-3">
                        <a asp-action="Index" class="text-decoration-none fw-bold" style="color:#7A1FA2;">
                            ← Volver
                        </a>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

