@model Proveedor

<div class="d-flex justify-content-center py-5" style="background-color: #730D4E; min-height: 100vh;">
    <div class="card shadow-lg border-0 rounded-4" style="width: 28rem; background-color: #C71585; color: white;">

        <div class="card-header text-center fw-bold fs-4 border-0" style="background-color: #C71585; color: white;">
            Registro de Proveedores
        </div>

        <div class="card-body p-4">

            <!-- Mostrar mensajes -->
            @if (TempData["mensaje"] != null)
            {
                <div class="alert alert-success">@TempData["mensaje"]</div>
            }
            @if (TempData["error"] != null)
            {
                <div class="alert alert-danger">@TempData["error"]</div>
            }

        </div>

        <div class="card-body p-4" style="background-color: #C71585;">
            <form asp-action="RegistroProveedor_Post" method="post">

                <div class="mb-3">
                    <label for="nombre" class="form-label fw-semibold">Nombre</label>
                    <input asp-for="Nombre" class="form-control border-0" placeholder="Ingrese el nombre del proveedor" required />
                </div>

                <div class="mb-3">
                    <label for="telefono" class="form-label fw-semibold">Teléfono</label>
                    <input asp-for="Telefono" class="form-control border-0" placeholder="Ingrese el número de teléfono" required />
                </div>

                <div class="mb-3">
                    <label for="correo" class="form-label fw-semibold">Correo</label>
                    <input asp-for="Correo" type="email" class="form-control border-0" placeholder="ejemplo@correo.com" required />
                </div>

                <div class="mb-3">
                    <label for="descripcion" class="form-label fw-semibold">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control border-0" rows="4" placeholder="Escribe una descripción aquí..." required></textarea>
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn fw-bold me-2" style="background-color: gold; color: black;">
                        Registrar
                    </button>

                    <a asp-controller ="Tambo" asp-action="MenuPrincipal" class="btn btn-danger">Cancelar</a>
                </div>
            </form>
        </div>

    </div>
</div>