@model IEnumerable<MVC_TAMBOv2.Models.Producto>

<h2 class="fw-bold text-center mb-4" style="color:#7A1FA2;">Lista de Productos</h2>

<div class="text-end mb-3">
    <a asp-action="AgregarProducto" class="btn btn-tambo">
        Registrar Producto
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover tambo-table shadow-sm">
        <thead class="table-tambo-header">
            <tr>
                <th>Categoría</th>
                <th>Marca</th>
                <th>Nombre</th>
                <th>Precio Unitario</th>
                <th>Fecha expiración</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Categoria?.NombreCategoria</td>
                    <td>@product.Marca?.Nombre</td>
                    <td>@product.Nombre</td>
                    <td>S/ @product.PrecioUnitario</td>
                    <td>@product.FechaExpiracion?.ToString("yyyy-MM-dd")</td>

                    <td class="text-center">

                        <a asp-controller="Tambo"
                           asp-action="RegistrarSalida"
                           asp-route-idProducto="@product.IdProducto"
                           class="btn btn-mostaza btn-sm">
                            Salida
                        </a>

                        <a asp-action="RegistrarEntrada"
                           asp-route-idProducto="@product.IdProducto"
                           class="btn btn-tambo btn-sm ms-1">
                            Entrada
                        </a>

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
